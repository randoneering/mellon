{
  "name": "mellon-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node automation/ci/run-tests.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:intake:db": "node scripts/test-agent-intake-db.mjs",
    "test:worker:db": "node scripts/test-agent-intake-db.mjs --suite worker",
    "test:worker:journal:db": "node scripts/test-agent-intake-db.mjs --suite journal",
    "test:worker:coordinator:db": "node scripts/test-agent-intake-db.mjs --suite coordinator",
    "test:worker:runtime:db": "node scripts/test-agent-intake-db.mjs --suite runtime",
    "test:build": "node --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test:parity": "node --test detector/tests/parity.test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@neon/ai-sdk-provider": "1.3.1",
    "@neon/functions": "0.11.0",
    "acorn": "8.19.0",
    "ai": "7.0.164",
    "markdown-it": "15.0.3",
    "pg": "8.23.1",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@neon/config": "1.11.3",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  }
}
