{
  "name": "mellon-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 detector/tests/*.test.mjs tests/unit/*.test.mjs tests/integration/*.test.mjs scripts/tests/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:build": "node --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test:parity": "node --test detector/tests/parity.test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  }
}
